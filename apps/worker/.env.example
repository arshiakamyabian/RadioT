NODE_ENV=development
LOG_LEVEL=info
# Local stand-in for the Vercel function (pnpm dev)
PORT=4100
DATABASE_URL=postgres://radiot:radiot@localhost:5432/radiot
# Where to report finished jobs, and the shared secret (same value as apps/api)
API_URL=http://localhost:4000
INTERNAL_SECRET=dev-internal-secret-change-me

# Vercel Blob read/write token (same store as apps/api)
BLOB_READ_WRITE_TOKEN=
MEDIA_BASE_URL=

# Media tools. Defaults: vendored static binaries on Vercel, system ffmpeg/fpcalc locally
# (brew install ffmpeg chromaprint).
FFMPEG_PATH=
# Pretrained-model analysis (docs/ml-models.md): Python of apps/worker/ml/.venv. Empty = off.
ML_PYTHON=
# auto | cpu | mps | cuda
ML_DEVICE=
# htdemucs (~4 min per song on 4 ARM cores) or htdemucs_ft (default, ~12 min, slightly cleaner stems)
ML_STEM_MODEL=
FPCALC_PATH=
# Sentry error reporting. Disabled when empty.
SENTRY_DSN=
