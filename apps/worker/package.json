{
  "name": "@radiot/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --exclude \"../../node_modules/**\" --exclude \"**/node_modules/**\" --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/vendor-tools.mjs",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "fallback:import": "tsx --env-file-if-exists=.env scripts/import-fallback.ts",
    "ml:backfill": "tsx --env-file-if-exists=.env scripts/ml-backfill.ts",
    "ml:setup": "bash ml/setup.sh"
  },
  "dependencies": {
    "@radiot/db": "workspace:*",
    "@radiot/shared": "workspace:*",
    "@sentry/node": "^11.12.0",
    "@vercel/blob": "^2.9.0",
    "@vercel/functions": "^3.11.3",
    "ffmpeg-static": "^5.3.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  }
}
