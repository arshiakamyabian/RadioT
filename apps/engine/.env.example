NODE_ENV=development
LOG_LEVEL=info
# HTTP: HLS (/hls/*), MP3 fallback (/radiot.mp3), state (/now, /events). Bind 0.0.0.0 to test on a phone.
HOST=0.0.0.0
PORT=4200
# The station timeline (apps/api). The engine polls it and plays what it says.
API_URL=http://localhost:4000
# Where browsers reach this engine (used in the URLs it hands out). Empty = same origin as the request.
PUBLIC_URL=
# Where listeners' players are allowed to call from (CORS). Comma-separated; * = any.
CORS_ORIGINS=*

# Work folder: media cache, HLS segments, Icecast and Liquidsoap logs.
RUN_DIR=./run
# Cache of the tracks and transition clips as FLAC, in MB (oldest unused files go first).
CACHE_MAX_MB=4096

# Local processes started with the engine (set SPAWN=0 to run Liquidsoap/Icecast yourself).
SPAWN=1
FFMPEG_PATH=ffmpeg
LIQUIDSOAP_PATH=liquidsoap
ICECAST_PATH=icecast
LIQ_TELNET_PORT=1234
ICECAST_PORT=8000
ICECAST_SOURCE_PASSWORD=radiot-source
ICECAST_ADMIN_PASSWORD=radiot-admin
# Where Icecast shares its web/admin files (brew: /opt/homebrew/share/icecast)
ICECAST_SHARE=/opt/homebrew/share/icecast

# HLS: 2 s segments, 10 in the live window.
HLS_SEGMENT_SECONDS=2
HLS_SEGMENTS=10
# Delay between the engine's clock and what a listener hears (shown timeline offset), ms.
STREAM_DELAY_MS=9000
