{
  "name": "@radiot/engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --exclude \"../../node_modules/**\" --exclude \"**/node_modules/**\" --exclude \"run/**\" --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@radiot/shared": "workspace:*",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  }
}
