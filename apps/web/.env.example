# Public base URL of this site (canonical URLs, OG images, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Fastify API (auth, realtime)
NEXT_PUBLIC_API_URL=http://localhost:4000
# LiveKit Cloud websocket URL (Phase 6)
NEXT_PUBLIC_LIVEKIT_URL=
# Cloudflare Turnstile site key (write endpoints). Disabled when empty.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# PostHog product analytics. Disabled when empty.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Only when web and API are on different sites (e.g. two *.vercel.app URLs): set NEXT_PUBLIC_API_URL to this
# site's URL, API_PROXY_TARGET to the API URL (web proxies /api/*), and NEXT_PUBLIC_SOCKET_URL to the API URL.
API_PROXY_TARGET=
NEXT_PUBLIC_SOCKET_URL=
