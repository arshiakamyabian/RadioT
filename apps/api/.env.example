NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Public URL of this API (used for auth callback links) and of the web app (CORS + redirects)
API_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
EXTRA_WEB_ORIGINS=

# Neon Postgres (pooled connection string) and Upstash Redis (rediss://, TCP).
# Both come from the Vercel Marketplace; `vercel env pull` fills them in.
DATABASE_URL=postgres://radiot:radiot@localhost:5432/radiot
REDIS_URL=redis://localhost:6379

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-32-byte-random-secret
# Parent domain for cookies in production (e.g. radiot.app). Leave empty locally.
COOKIE_DOMAIN=

# Google OAuth (optional locally; Google sign-in is disabled when empty)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP for magic links (e.g. Resend: smtps://resend:<key>@smtp.resend.com:465).
# Leave empty to print magic links in the API log instead.
SMTP_URL=
MAIL_FROM=RadioT <no-reply@radiot.local>

# LiveKit Cloud (Phase 6)
LIVEKIT_HOST=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Salt for hashing IPs stored with requests/votes (rights + abuse accountability)
IP_HASH_SALT=change-me

# API <-> worker shared secret (any long random string, same value in apps/worker)
INTERNAL_SECRET=dev-internal-secret-change-me
# Where the worker deployment lives (local: pnpm dev runs it on 4100)
WORKER_URL=http://localhost:4100

# Vercel Blob read/write token (Vercel dashboard > Storage > Blob; injected automatically on Vercel)
BLOB_READ_WRITE_TOKEN=
# Public base URL of the Blob store. Leave empty to derive it from the token.
MEDIA_BASE_URL=

# Cloudflare Turnstile (write endpoints). Disabled when empty.
TURNSTILE_SECRET_KEY=

# Web push (generate with: npx web-push generate-vapid-keys). Disabled when empty.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@radiot.app

# Sentry error reporting. Disabled when empty.
SENTRY_DSN=
