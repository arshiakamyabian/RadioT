{
  "name": "@radiot/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --exclude \"../../node_modules/**\" --exclude \"**/node_modules/**\" --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "@types/web-push": "^3.6.4"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@radiot/db": "workspace:*",
    "@radiot/shared": "workspace:*",
    "@sentry/node": "^11.12.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@vercel/blob": "^2.9.0",
    "@vercel/functions": "^3.11.3",
    "better-auth": "^1.7.24",
    "fastify": "^5.12.8",
    "ioredis": "^6.0.0",
    "livekit-server-sdk": "^2.19.3",
    "nodemailer": "^10.5.0",
    "pino": "^10.4.0",
    "socket.io": "^4.8.4",
    "web-push": "4.0.0",
    "zod": "^4.6.7"
  }
}
